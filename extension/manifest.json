{
  "manifest_version": 3,
  "name": "TruePrice",
  "version": "2.0.0",
  "description": "Crowdsourced eBay price tracker with reputation-weighted price history charts.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.ebay.com/*",
    "https://*.ebay.co.uk/*",
    "https://*.ebay.in/*",
    "https://*.ebay.de/*",
    "https://*.ebay.ca/*",
    "https://*.ebay.com.au/*",
    "http://vm:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "action": {
    "default_icon": {
      "16": "logo.png",
      "32": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.ebay.com/itm/*",
        "https://*.ebay.co.uk/itm/*",
        "https://*.ebay.in/itm/*",
        "https://*.ebay.de/itm/*",
        "https://*.ebay.ca/itm/*",
        "https://*.ebay.com.au/itm/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dashboard.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
